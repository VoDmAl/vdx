{
  "name": "vdx-cli",
  "version": "0.1.0",
  "description": "vdx — unified lifecycle interface + maturity audit (v0.1 evaluator)",
  "private": true,
  "type": "module",
  "bin": {
    "vdx": "src/index.ts"
  },
  "scripts": {
    "vdx": "tsx src/index.ts",
