{
  "name": "@vodmal/vdx-cli",
  "version": "0.39.0",
  "description": "vdx — unified lifecycle interface (up/down/build/test/check/fix) + versioned maturity audit with drift detection. Pairs with the vdx Claude Code plugin.",
  "keywords": [
    "vdx",
    "lifecycle",
    "audit",
    "rubric",
    "mise",
    "claude-code",
    "mcp",
    "drift"
  ],
  "homepage": "https://github.com/VoDmAl/vdx#readme",
  "bugs": "https://github.com/VoDmAl/vdx/issues",
  "license": "MIT",
  "author": "VoDmAl",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VoDmAl/vdx.git",
    "directory": "cli"
  },
  "type": "module",
  "bin": {
    "vdx": "bin/vdx.cjs",
    "vdx-mcp": "bin/vdx-mcp.cjs"
  },
  "files": [
    "src",
    "rubric",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "vdx": "tsx src/index.ts",
    "vdx-mcp": "tsx src/mcp-server.ts",
    "audit": "tsx src/index.ts audit",
    "smoke": "bash smoke.sh",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "knip": "knip",
    "check": "npm run typecheck && npm run format:check && npm run lint && npm run knip",
    "check:code:security": "npm audit --omit=dev",
    "fix": "eslint --fix . && prettier --write .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "cli-table3": "^0.6.5",
    "js-yaml": "^5.4.3",
    "marked": "^18.1.0",
    "marked-terminal": "^7.3.0",
    "smol-toml": "^1.3.0",
    "tsx": "^4.19.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/js-yaml": "^4.0.9",
    "@types/marked-terminal": "^6.1.1",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "knip": "^6.41.0",
    "prettier": "^3.9.10",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  }
}
